# Telegram
BOT_TOKEN=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gamebot
DB_USER=gamebot
DB_PASSWORD=
DB_PATH=./data/mysql

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-1

# Media files
MEDIA_PATH=./assets/media
# Persistent cache of Telegram file_ids. Stored as JSON. After the first
# successful upload, file_ids are reused so the bot does not re-upload
# the same GIF/photo — this is what keeps task_10 below Telegram's
# per-chat media flood limit on subsequent runs. Set to an empty value
# to disable persistence (cache stays in-memory only).
MEDIA_CACHE_PATH=./data/media_cache.json

# Logging
LOG_LEVEL=info
LOG_FILE=

# Support
SUPPORT_TELEGRAM_URL=https://t.me/username

# Timing (production)
DELETE_MESSAGE_DELAY=10s
JOIN_MESSAGE_DELAY=1s
TASK_INFO_INTERVAL=1s
SUBTASK_LOCK_TIMEOUT=15m
TASK_PUBLISH_INTERVAL=24h
TASK_FINALIZE_OFFSET=23h
REMINDER_DELAY=12h
POLL_DURATION=24h
MEME_COLD_CACHE_DELAY=20s

# Test mode
TEST_MODE=false
TEST_TASK_PUBLISH_INTERVAL=2m
TEST_TASK_FINALIZE_OFFSET=1m50s
TEST_REMINDER_DELAY=30s
TEST_POLL_DURATION=1m
TEST_MEME_COLD_CACHE_DELAY=3s
